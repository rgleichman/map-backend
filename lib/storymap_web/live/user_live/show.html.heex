<Layouts.app flash={@flash} current_scope={@current_scope}>
  <%= if @not_found do %>
    <div class="max-w-xl mx-auto px-4 py-10">
      <div class="card bg-base-100 border border-base-300 shadow-sm">
        <div class="card-body">
          <h1 class="text-3xl font-bold mb-4 text-base-content">
            404 - User Not Found
          </h1>
          <p class="text-base-content/70">The user you are looking for does not exist.</p>
        </div>
      </div>
    </div>
  <% else %>
    <div class="max-w-xl mx-auto px-4 py-10">
      <div class="card bg-base-100 border border-base-300 shadow-sm">
        <div class="card-body">
          <h1 class="text-3xl font-bold mb-4 text-base-content">User {@user.id}</h1>

          <%= if @own_profile? do %>
            <div class="mt-8 pt-6 border-t border-base-300">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <h2 class="text-lg font-semibold text-base-content">Saved pins</h2>
                <%= if @saved_pins_count > 0 do %>
                  <.link navigate={~p"/saved"} class="link link-primary text-sm font-medium">
                    See all ({@saved_pins_count})
                  </.link>
                <% end %>
              </div>

              <%= if @saved_pins_preview == [] do %>
                <p class="text-sm text-base-content/70">
                  You have not saved any pins yet.
                  <.link navigate={~p"/"} class="link link-primary">Browse the map</.link>
                  to find pins to save.
                </p>
              <% else %>
                <ul class="space-y-2">
                  <%= for pin <- @saved_pins_preview do %>
                    <li id={"profile-saved-pin-#{pin.id}"}>
                      <.link
                        href={Storymap.Pins.map_path_for_pin(pin)}
                        class="flex items-center justify-between gap-3 rounded-lg px-3 py-2 hover:bg-base-200 transition-colors"
                      >
                        <span class="font-medium text-base-content truncate">{pin.title}</span>
                        <%= if pin.sub_map do %>
                          <span class="text-xs text-base-content/60 shrink-0">{pin.sub_map.name}</span>
                        <% end %>
                      </.link>
                    </li>
                  <% end %>
                </ul>
                <%= if @saved_pins_count > length(@saved_pins_preview) do %>
                  <.button navigate={~p"/saved"} variant="ghost" size="sm" class="mt-4">
                    See all saved pins
                  </.button>
                <% end %>
              <% end %>
            </div>

            <div class="mt-8 pt-6 border-t border-base-300">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <h2 class="text-lg font-semibold text-base-content">My contributions</h2>
                <%= if @contributions_count > 0 do %>
                  <.link
                    navigate={~p"/contributions"}
                    class="link link-primary text-sm font-medium"
                  >
                    See all ({@contributions_count})
                  </.link>
                <% end %>
              </div>

              <%= if @contributions_preview == [] do %>
                <p class="text-sm text-base-content/70">
                  You have not created any pins yet.
                  <.link navigate={~p"/"} class="link link-primary">Browse the map</.link>
                  to add one.
                </p>
              <% else %>
                <ul class="space-y-2">
                  <%= for pin <- @contributions_preview do %>
                    <li id={"profile-contribution-pin-#{pin.id}"}>
                      <.link
                        href={Storymap.Pins.map_path_for_pin(pin)}
                        class="flex items-center justify-between gap-3 rounded-lg px-3 py-2 hover:bg-base-200 transition-colors"
                      >
                        <span class="min-w-0 flex flex-wrap items-center gap-2">
                          <span class="font-medium text-base-content truncate">{pin.title}</span>
                          <span class={"badge badge-sm #{Storymap.Pins.Pin.status_badge_class(pin.status)}"}>
                            {Storymap.Pins.Pin.status_label(pin.status)}
                          </span>
                        </span>
                        <%= if pin.sub_map do %>
                          <span class="text-xs text-base-content/60 shrink-0">{pin.sub_map.name}</span>
                        <% end %>
                      </.link>
                    </li>
                  <% end %>
                </ul>
                <%= if @contributions_count > length(@contributions_preview) do %>
                  <.button navigate={~p"/contributions"} variant="ghost" size="sm" class="mt-4">
                    See all contributions
                  </.button>
                <% end %>
              <% end %>
            </div>

            <div class="mt-8 pt-6 border-t border-base-300">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <h2 class="text-lg font-semibold text-base-content">Communities</h2>
                <%= if @communities_count > 0 do %>
                  <.link navigate={~p"/m"} class="link link-primary text-sm font-medium">
                    See all ({@communities_count})
                  </.link>
                <% end %>
              </div>

              <%= if @communities_preview == [] do %>
                <p class="text-sm text-base-content/70">
                  You have not joined any communities yet. Only you can see this list.
                  <.link navigate={~p"/m"} class="link link-primary">Browse communities</.link>
                  to find one.
                </p>
              <% else %>
                <p class="text-sm text-base-content/70 mb-3">Only you can see this list.</p>
                <ul class="space-y-2">
                  <%= for membership <- @communities_preview do %>
                    <li id={"profile-community-#{membership.sub_map.id}"}>
                      <.link
                        navigate={~p"/m/#{membership.sub_map.community_url}/map"}
                        class="flex items-center justify-between gap-3 rounded-lg px-3 py-2 hover:bg-base-200 transition-colors"
                      >
                        <span class="font-medium text-base-content truncate">
                          {membership.sub_map.name}
                        </span>
                        <%= if membership.role in [:owner, :moderator] do %>
                          <span class="badge badge-sm badge-outline capitalize shrink-0">
                            {membership.role}
                          </span>
                        <% end %>
                      </.link>
                    </li>
                  <% end %>
                </ul>
                <%= if @communities_count > length(@communities_preview) do %>
                  <.button navigate={~p"/m"} variant="ghost" size="sm" class="mt-4">
                    See all communities
                  </.button>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</Layouts.app>
