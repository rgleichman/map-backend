<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-4xl mx-auto px-4 py-10">
    <div class="space-y-2 mb-8">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="space-y-2">
          <h1 class="text-3xl font-bold text-base-content">{GardenCopy.gardens()}</h1>
          <p class="text-base-content/70">
            {GardenCopy.gardens_blurb()}
          </p>
        </div>
        <%= if @current_scope && @current_scope.user && user_can_write?(@current_scope) do %>
          <.button navigate={~p"/m/new"} variant="primary" class="shrink-0" id="sub-maps-create">
            {GardenCopy.create_a_garden()}
          </.button>
        <% else %>
          <.button
            navigate={~p"/users/log-in"}
            variant="primary"
            class="shrink-0"
            id="sub-maps-create"
          >
            Sign in to create
          </.button>
        <% end %>
      </div>
    </div>

    <%= if @my_memberships != [] do %>
      <section id="my-communities" class="mb-10 space-y-4">
        <div class="space-y-1">
          <h2 class="text-xl font-semibold text-base-content">{GardenCopy.your_gardens()}</h2>
          <p class="text-sm text-base-content/70">
            Only you can see this list.
          </p>
        </div>
        <ul id="my-communities-list" class="grid gap-4 sm:grid-cols-2">
          <%= for membership <- @my_memberships do %>
            <li id={"my-community-#{membership.sub_map.id}"}>
              <.link
                navigate={~p"/m/#{membership.sub_map.community_url}/map"}
                class="card bg-base-200/50 border border-base-300 hover:border-primary/40 transition-colors"
              >
                <div class="card-body">
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="card-title text-lg">{membership.sub_map.name}</h3>
                    <%= if membership.role in [:owner, :moderator] do %>
                      <span class="badge badge-sm badge-outline capitalize">
                        {GardenCopy.membership_role_label(membership.role)}
                      </span>
                    <% end %>
                  </div>
                  <p class="text-sm text-base-content/70 line-clamp-2">
                    {membership.sub_map.description}
                  </p>
                </div>
              </.link>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <form id="sub-maps-search" phx-change="search" class="mb-8">
      <label for="sub-maps-search-input" class="sr-only">{GardenCopy.search_gardens()}</label>
      <input
        id="sub-maps-search-input"
        type="search"
        name="q"
        value={@search_query}
        placeholder={GardenCopy.search_by_name_or_garden_url()}
        class="input input-bordered w-full max-w-md"
        autocomplete="off"
      />
    </form>

    <%= if @sub_maps == [] do %>
      <div
        id="sub-maps-empty"
        class="rounded-xl border border-base-300 bg-base-200/30 p-8 text-center space-y-4"
      >
        <p class="text-base-content/80">
          {GardenCopy.no_gardens_yet()}
        </p>
        <%= if @current_scope && @current_scope.user && user_can_write?(@current_scope) do %>
          <.button navigate={~p"/m/new"} variant="primary">
            {GardenCopy.create_a_garden()}
          </.button>
        <% else %>
          <.button navigate={~p"/users/log-in"} variant="primary">
            {GardenCopy.sign_in_to_create_garden()}
          </.button>
        <% end %>
      </div>
    <% else %>
      <ul id="sub-maps-list" class="grid gap-4 sm:grid-cols-2">
        <%= for sub_map <- @sub_maps do %>
          <li>
            <.link
              navigate={~p"/m/#{sub_map.community_url}/map"}
              class="card bg-base-200/50 border border-base-300 hover:border-primary/40 transition-colors"
            >
              <div class="card-body">
                <h2 class="card-title text-lg">{sub_map.name}</h2>
                <p class="text-sm text-base-content/70 line-clamp-2">{sub_map.description}</p>
              </div>
            </.link>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</Layouts.app>
